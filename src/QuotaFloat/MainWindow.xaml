<Window x:Class="QuotaFloat.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QuotaFloat"
 Title="Codex 额度浮窗" Width="112" Height="320" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
 <Border Margin="8" Background="Transparent" MouseEnter="GaugeEntered" MouseLeave="GaugeLeft"
  PreviewMouseLeftButtonDown="GaugePressed" PreviewMouseLeftButtonUp="GaugeReleased" MouseMove="GaugeMoved">
  <local:QuotaGauge x:Name="Gauge" ToolTip="拖动停靠 · 点击固定详情 · 右键设置 · Enter展开">
   <local:QuotaGauge.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" Color="#41616B"/></local:QuotaGauge.Effect>
  </local:QuotaGauge>
 </Border>
</Window>
