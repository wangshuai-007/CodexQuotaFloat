<Window x:Class="QuotaFloat.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 额度浮窗 · 设置"
 Width="570" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="28">
  <TextBlock Text="浮窗设置" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <CheckBox x:Name="TopmostOption" Content="始终置顶"/>
  <CheckBox x:Name="DockOption" Content="拖动到屏幕边缘时自动停靠"/>
  <CheckBox x:Name="MotionOption" Content="减弱动效"/>
  <TextBlock Text="浮窗总额度水位" Margin="0,16,0,8" FontWeight="SemiBold"/>
  <ComboBox x:Name="QuotaDisplayOption" Height="38" AutomationProperties.Name="浮窗总额度水位">
   <ComboBoxItem Content="5h 剩余额度"/>
   <ComboBoxItem Content="7天 剩余额度"/>
   <ComboBoxItem Content="左右双水位（左5h · 右7天）"/>
  </ComboBox>
  <TextBlock Text="按全部有效账号等权平均；双水位独立计算，不是Token绝对总量。" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
  <TextBlock Text="数据源" Margin="0,20,0,8" FontWeight="SemiBold"/>
  <ComboBox x:Name="SourceOption" Height="38" SelectionChanged="SourceChanged">
   <ComboBoxItem Content="演示数据（不访问网络）"/>
   <ComboBoxItem Content="CPA 管理额度"/>
   <ComboBoxItem Content="本地 Codex 认证（ChatGPT登录）"/>
  </ComboBox>
  <StackPanel x:Name="LocalAuthSection" Visibility="Collapsed">
   <TextBlock Text="Codex 认证文件（留空自动使用本地CLI认证）" Margin="0,16,0,6" FontSize="14"/>
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="选择文件" Click="BrowseAuthClicked" Margin="8,0,0,0"/>
    <TextBox x:Name="LocalAuthOption"/>
   </DockPanel>
   <TextBlock x:Name="DefaultAuthLabel" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
   <TextBlock Text="默认通过官方Codex CLI读取当前ChatGPT额度，支持CLI的文件/keyring认证，CLI自行维护登录缓存。手动选文件时只读auth.json，不复制或刷新令牌；未安装CLI则尝试默认文件。不经过CPA，不创建推理请求。API Key不提供订阅额度，本地认证不提供最近60秒请求流量。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
  </StackPanel>
  <StackPanel x:Name="DemoSection">
  <TextBlock Text="演示账号数量（0–100；每页最多显示10个）" Margin="0,16,0,6" FontSize="14"/>
  <TextBox x:Name="DemoCountOption"/>
  </StackPanel>
  <StackPanel x:Name="CpaSection">
  <TextBlock Text="CPA 管理地址" Margin="0,16,0,6" FontSize="14"/>
  <TextBox x:Name="UrlOption" ToolTip="新版 /v8/management；已有旧版可填 /v0/management"/>
  <TextBlock Text="CPA 管理密钥（仅本次会话，不写入设置文件）" Margin="0,16,0,6" FontSize="14"/>
  <PasswordBox x:Name="KeyOption"/>
  <TextBlock Text="也可通过 CPA_MANAGEMENT_KEY 环境变量提供。只查询额度，不重置账号；远端地址必须使用 HTTPS。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0"/>
  </StackPanel>
  <TextBlock Text="同步间隔（5–3600秒；额度与流量独立刷新）" Margin="0,16,0,6" FontSize="14"/>
  <TextBox x:Name="IntervalOption"/>
  <StackPanel x:Name="TrafficSection">
  <TextBlock Text="只读流量快照地址（可选，同CPA域名及端口）" Margin="0,16,0,6" FontSize="14"/>
  <TextBox x:Name="TrafficUrlOption"/>
  <TextBlock Text="仅统计最近60秒已完成请求的Token与次数，不消费usage队列。旧版可留空读取 /usage；CPA v8需提供只读统计服务。短间隔会增加查询频率，不显示进行中请求的逐Token流。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
  </StackPanel>
  <TextBlock x:Name="ValidationError" Foreground="{StaticResource Danger}" TextWrapping="Wrap" FontSize="14" Margin="0,12,0,0"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="取消" IsCancel="True"/>
   <Button Content="保存并刷新" IsDefault="True" Click="SaveClicked" Margin="10,0,0,0"/>
  </StackPanel>
 </StackPanel>
 </ScrollViewer>
</Window>
